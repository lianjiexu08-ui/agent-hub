{
  "name": "agent-hub",
  "version": "1.0.0",
  "description": "AI 驱动的多智能体研发协作平台：项目绑定 GitHub 仓库，智能体按 需求理解→计划→执行→测试→评审 的生命周期自主交付",
  "scripts": {
    "start": "node src/index.ts",
    "demo": "HUB_SIMULATE=1 HUB_DATA=./data-demo node src/index.ts",
    "demo:lan": "HOST=0.0.0.0 HUB_SIMULATE=1 HUB_DATA=./data-demo node src/index.ts",
    "mcp": "node src/mcp.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "claude",
    "orchestration",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.21",
    "playwright-core": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
